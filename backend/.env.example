# AI-Powered Document Intelligence Platform - Backend Configuration Template
# Copy this file to .env and customize values

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Mode: "gemini" or "mock"
LLM_MODE=gemini
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL Database Configuration
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Examples:
#   Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/docuintel
#   Supabase / Neon: postgresql://postgres.xxxx:your_password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docuintel

# Backend Filesystem Storage Directory for Uploaded Files
UPLOAD_DIR=uploads

# Server Host & Port
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*

# Document Processing & Upload Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# AI Image Generation
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
